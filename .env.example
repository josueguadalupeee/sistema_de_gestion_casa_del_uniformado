SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# DB_ENGINE=sqlite (default) o DB_ENGINE=postgresql
DB_ENGINE=sqlite
DB_NAME=casa_uniformado
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# EMAIL_BACKEND=console (default) o EMAIL_BACKEND=smtp para alertas de restock reales
EMAIL_BACKEND=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Correo(s) que reciben el reporte diario de stock bajo (separados por coma)
STOCK_ALERT_RECIPIENTS=dueño@ejemplo.com

# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
TASK_SECRET_TOKEN=

IVA_PORCENTAJE=15.00
